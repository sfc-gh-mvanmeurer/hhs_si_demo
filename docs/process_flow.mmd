flowchart LR
    subgraph DATA["📊 CMS Sample Data<br>2008 & 2010"]
        BENE["Beneficiary<br>Summary"]
        INPT["Inpatient<br>Claims"]
        OUTPT["Outpatient<br>Claims"]
        RX["Prescription<br>Drug Events"]
        CARRIER["Carrier<br>Claims"]
    end

    subgraph PYTHON["🐍 Python Preparation — prepare_fraud_data.py"]
        LOAD["Load Claims<br>+ Beneficiaries"]
        SAMPLE["Sample Claims<br>for Flagging"]
        ASSIGN["Assign Fraud<br>Patterns"]
        
        subgraph PATTERNS["Fraud Patterns"]
            direction TB
            P1["UPCODING"]
            P2["UNBUNDLING"]
            P3["PHANTOM_BILLING"]
            P4["PROVIDER_HOPPING"]
            P5["DUPLICATE_BILLING"]
            P6["MEDICALLY_UNLIKELY"]
        end
        
        SCORE["Generate Scores<br>+ Risk Tiers"]
        NOTES["Generate Case<br>Notes"]
        REFS["Create Reference<br>Tables"]
    end

    subgraph OUTPUT["📁 Prepared Files"]
        FC["flagged_claims.csv"]
        CN["case_notes.csv"]
        REF["ref_*.csv"]
    end

    subgraph SNOW["❄️ Snowflake Platform"]
        subgraph STAGE["Internal Stage"]
            RAW["Raw Tables"]
        end
        
        subgraph ENG["Data Engineering"]
            ENRICH["Enriched Views"]
            UNIFIED["Unified Claims"]
            PROFILES["Provider Risk<br>Profiles"]
        end
        
        subgraph CORTEX["Cortex AI Layer"]
            SEM["Semantic Views<br>(Analyst)"]
            SEARCH["Cortex Search<br>(Case Notes)"]
            AISQL["AI SQL<br>Functions"]
        end
        
        subgraph INTEL["Snowflake Intelligence"]
            AGENT["Fraud Investigation<br>Assistant"]
        end
    end

    subgraph USER["👤 Human Review"]
        INV["Fraud<br>Investigators"]
        DECISION["Investigation<br>Decisions"]
    end

    %% Data to Python
    BENE --> LOAD
    INPT --> LOAD
    OUTPT --> LOAD
    
    %% Python pipeline
    LOAD --> SAMPLE
    SAMPLE --> ASSIGN
    ASSIGN --> P1
    P1 --> P2 --> P3 --> P4 --> P5 --> P6
    P6 --> SCORE
    SCORE --> NOTES
    SCORE --> FC
    NOTES --> CN
    ASSIGN --> REFS
    REFS --> REF
    
    %% Files to Snowflake
    FC --> RAW
    CN --> RAW
    REF --> RAW
    BENE --> RAW
    INPT --> RAW
    OUTPT --> RAW
    RX --> RAW
    CARRIER --> RAW
    
    %% Snowflake pipeline
    RAW --> ENRICH
    RAW --> UNIFIED
    ENRICH --> PROFILES
    UNIFIED --> PROFILES
    ENRICH --> SEM
    PROFILES --> SEM
    RAW --> SEARCH
    SEM --> AGENT
    SEARCH --> AGENT
    AISQL --> AGENT
    AGENT --> INV
    INV --> DECISION

    %% Styling for contrast
    style DATA fill:#E8F4FD,stroke:#1E88E5,stroke-width:2px,color:#1565C0
    style PYTHON fill:#FFF3E0,stroke:#F57C00,stroke-width:2px,color:#E65100
    style PATTERNS fill:#FCE4EC,stroke:#D81B60,stroke-width:2px,color:#AD1457
    style OUTPUT fill:#F3E5F5,stroke:#8E24AA,stroke-width:2px,color:#6A1B9A
    style SNOW fill:#E3F2FD,stroke:#29B5E8,stroke-width:3px,color:#0D47A1
    style STAGE fill:#BBDEFB,stroke:#29B5E8,stroke-width:1px,color:#1565C0
    style ENG fill:#90CAF9,stroke:#1E88E5,stroke-width:1px,color:#0D47A1
    style CORTEX fill:#64B5F6,stroke:#1565C0,stroke-width:1px,color:#0D47A1
    style INTEL fill:#29B5E8,stroke:#0D47A1,stroke-width:2px,color:#fff
    style USER fill:#FFECB3,stroke:#FFA000,stroke-width:2px,color:#FF6F00
    
